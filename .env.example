# URL Koneksi Database Supabase
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Dapatkan kunci di bawah ini dari Supabase Dashboard -> Project Settings -> API -> Project API keys (anon, public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_YOUR_KEY"
# ⚠️ Backend ONLY — Kunci Service Role (bypass RLS) untuk upload aman di server action
SUPABASE_SERVICE_ROLE_KEY="sb_secret_YOUR_SERVICE_ROLE_KEY"

# Konfigurasi Better Auth
# ⚠️ SECURITY: Generate secret yang KUAT minimal 64 karakter random!
# Jangan gunakan kata-kata yang bisa ditebak.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
BETTER_AUTH_SECRET="GENERATE_STRONG_SECRET_64_CHARS_MINIMUM"
FRONTEND_URL="https://your-domain.com"
BETTER_AUTH_URL="https://your-domain.com"
 
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
NEXT_PUBLIC_TOMTOM_API_KEY="YOUR_TOMTOM_API_KEY"
